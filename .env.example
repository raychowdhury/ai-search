# Copy to .env.local for local development. Never commit real keys.

# Where the SQLite file lives (default: ./data/app.db)
DATABASE_PATH=./data/app.db

# Live AI platforms. Leave unset to run in sample (demo) mode.
# Anthropic Claude API: answers via the web_search tool and competitor extraction.
ANTHROPIC_API_KEY=
ANTHROPIC_ANSWER_MODEL=claude-opus-5
ANALYSIS_MODEL=claude-opus-5

# OpenAI Responses API with web_search. Verified live 2026-09-21 with gpt-5.4-mini and gpt-5.5;
# gpt-5-mini requires OpenAI organization verification.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Perplexity Sonar API (implemented, not yet verified live).
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
PERPLEXITY_CONTEXT_SIZE=low

# Live checks per business per rolling day (abuse and cost cap). Sample checks are not capped.
LIVE_RUNS_PER_DAY=10

# Set to 1 to stop the in-process background worker (for example when running a separate worker).
DISABLE_WORKER=

# Public base URL used in emailed links.
APP_URL=http://localhost:3000

# Transactional email (password reset, email confirmation). Without these the
# "log" transport prints messages to the server log instead of sending them.
RESEND_API_KEY=
EMAIL_FROM=Mentioned <no-reply@example.com>

# Nightly SQLite backups are taken by the worker when this is set (and pruned after 14 days, keeping 7).
BACKUP_DIR=

# Optional JSON webhook for operator alerts (permanent job failures, backup failures).
ALERT_WEBHOOK_URL=
