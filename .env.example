# Copy to .env.local for local development. Never commit real keys.

# Where the SQLite file lives (default: ./data/app.db)
DATABASE_PATH=./data/app.db

# Live AI platforms. Leave unset to run in sample (demo) mode.
# Anthropic Claude API: answers via the web_search tool and competitor extraction.
ANTHROPIC_API_KEY=
ANTHROPIC_ANSWER_MODEL=claude-opus-5
ANALYSIS_MODEL=claude-opus-5

# OpenAI Responses API with web_search (implemented, not yet verified live).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Perplexity Sonar API (implemented, not yet verified live).
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
PERPLEXITY_CONTEXT_SIZE=low

# Set to 1 to stop the in-process background worker (for example when running a separate worker).
DISABLE_WORKER=
